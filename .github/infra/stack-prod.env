# App environment variables — injetadas na stack do Portainer.
# Preencha com valores reais do ambiente de produção.
# Variables with defaults in stack-prod.yml are commented; uncomment to override.

PUBLIC_URL=https://agents.swbolt.webck.com.br
# CORS_ORIGIN=
# SETUP_TOKEN_REQUIRED=false
# LOG_LEVEL=info
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/agents?sslmode=disable
DATABASE_URL=postgres://app_agent:CHANGE_ME@postgres:5432/agents?sslmode=disable
LANGGRAPH_DATABASE_URL=postgres://app_agent:CHANGE_ME@postgres:5432/agents?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# DATABASE_NAME=agents
